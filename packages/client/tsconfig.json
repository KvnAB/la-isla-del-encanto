{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@draycol/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
